/* pages/manager/index.wxss */

/* ===== 页面根容器 ===== */
.admin-page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 60rpx;
}

/* ===== 顶部欢迎条 ===== */
.admin-header {
  background: linear-gradient(135deg, #00c853, #00e676);
  padding: 60rpx 40rpx 50rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}
.header-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.header-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
}
.header-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}
.header-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background-color: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(255,255,255,0.5);
}
.avatar-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

/* ===== 菜单 Tab 栏 ===== */
.menu-bar {
  display: flex;
  background-color: #ffffff;
  margin: -30rpx 30rpx 30rpx;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
  position: relative;
  z-index: 10;
}
.menu-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 0;
  border-radius: 14rpx;
  transition: all 0.25s ease;
}
.menu-item.menu-active {
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
}
.menu-icon {
  font-size: 44rpx;
}
.menu-text {
  font-size: 26rpx;
  color: #555555;
  font-weight: 500;
}
.menu-item.menu-active .menu-text {
  color: #00c853;
  font-weight: 700;
}

/* ===== 面板通用 ===== */
.tab-panel {
  padding: 0 30rpx;
  animation: fadeIn 0.3s ease;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.panel-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}
.panel-title-text {
  font-size: 34rpx;
  font-weight: 800;
  color: #212529;
  position: relative;
  padding-left: 20rpx;
}
.panel-title-text::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 30rpx;
  background: #00c853;
  border-radius: 3rpx;
}
.panel-count {
  font-size: 24rpx;
  color: #888888;
}

/* ===== 表单卡片（发布商品） ===== */
.form-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 10rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  border: 1rpx solid #eef1f4;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.form-row:last-child {
  border-bottom: none;
}
.form-row-column {
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}
.form-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #495057;
  font-weight: 500;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  color: #212529;
}
.placeholder {
  color: #adb5bd;
  font-size: 26rpx;
}
.form-textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  color: #212529;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #e9ecef;
}

/* 上传图片区 */
.upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  width: 100%;
}
.upload-btn {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #c8e6c9;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background-color: #f8fdf8;
}
.upload-plus {
  font-size: 48rpx;
  color: #00c853;
  font-weight: 300;
  line-height: 1;
}
.upload-text {
  font-size: 22rpx;
  color: #66bb6a;
}
.upload-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background-color: #e9ecef;
  position: relative;
}
.thumb-close {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: #ff4d4f;
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e9ecef;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #212529;
}

/* ===== 商品管理卡片 ===== */
.goods-list-admin {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.goods-admin-card {
  display: flex;
  align-items: center;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  border: 1rpx solid #eef1f4;
  gap: 24rpx;
}
.goods-admin-card-onShelf {
  background-color: #ffffff;
}
.goods-admin-card-offShelf {
  background-color: rgb(200, 200, 200);
}
.goods-admin-img-placeholder {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  background-color: #f0f2f5;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.goods-admin-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  overflow: hidden;
}
.goods-admin-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #212529;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.goods-admin-meta {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.goods-admin-price {
  font-size: 32rpx;
  font-weight: 800;
  color: #ff4d4f;
}
.goods-admin-sales {
  font-size: 22rpx;
  color: #888888;
}
.goods-admin-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}
.action-btn {
  padding: 14rpx 28rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}
.offshelf-btn {
  background-color: #fff3e0;
  color: #f57c00;
}
.onshelf-btn {
  background-color: #e8f5e9;
  color: #2e7d32;
}
.edit-btn {
  background-color: #e3f2fd;
  color: #1976d2;
}

/* ===== 用户表格 ===== */
.user-table {
  background-color: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  border: 1rpx solid #eef1f4;
}
.table-header {
  display: flex;
  align-items: center;
  background-color: #f8f9fa;
  padding: 24rpx 20rpx;
  border-bottom: 2rpx solid #e9ecef;
}
.th {
  font-size: 24rpx;
  font-weight: 700;
  color: #6c757d;
  text-align: center;
}
.th-user    { flex: 2.2; text-align: left; padding-left: 8rpx; }
.th-phone   { flex: 1.8; }
.th-role    { flex: 1.4; }
.th-status  { flex: 1.4; display: flex; align-items: center; justify-content: center; gap: 6rpx; }
.th-action  { flex: 1.2; }

.table-row {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f0f2f5;
}
.table-row:last-child {
  border-bottom: none;
}

.user-cell {
  display: flex;
  align-items: center;
  gap: 14rpx;
  text-align: left !important;
}
.user-avatar-small {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #00c853, #00e676);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.user-name {
  font-size: 28rpx;
  color: #212529;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-badge {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
  line-height: 1; 
  display: inline-flex; 
  align-items: center;
  justify-content: center;
}
.role-admin {
  background-color: #ede7f6;
  color: #7b1fa2;
}
.role-user {
  background-color: #e8f5e9;
  color: #2e7d32;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  display: inline-block;
}
.status-normal {
  background-color: #4caf50;
}
.status-banned {
  background-color: #ff4d4f;
}
.status-text {
  font-size: 22rpx;
  color: #495057;
}

.action-btn-small {
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}
.btn-disable {
  background-color: #ffebee;
  color: #d32f2f;
}
.btn-enable {
  background-color: #e8f5e9;
  color: #2e7d32;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
}
.empty-icon {
  font-size: 80rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #adb5bd;
}