/* pages/cart/cart.wxss */

/* ===== 整体容器 ===== */
.cart-container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

/* ===== 空状态 ===== */
.cart-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 220rpx;
}
.cart-empty .empty-img {
  width: 260rpx;
  height: 260rpx;
  opacity: 0.5;
}
.cart-empty .empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #bbb;
}
.cart-empty .empty-btn {
  margin-top: 48rpx;
  padding: 20rpx 72rpx;
  background-color: #00cc99;
  color: #fff;
  font-size: 28rpx;
  border-radius: 44rpx;
}

/* ===== 头部 ===== */
.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.cart-header .cart-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.cart-header .cart-edit {
  font-size: 28rpx;
  color: #1677ff;
}

/* ===== 商品列表 ===== */
.cart-list {
  padding: 20rpx 24rpx;
}
.cart-item {
  display: flex;
  align-items: center;
  position: relative;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

/* 勾选圆圈 */
.item-check {
  margin-right: 18rpx;
  flex-shrink: 0;
}
.check-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  border: 2rpx solid #d9d9d9;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: all 0.2s;
}
.check-icon.checked {
  background-color: #1677ff;
  border-color: #1677ff;
}
.check-icon .check-text {
  font-size: 24rpx;
  color: #fff;
  line-height: 1;
}

/* 商品图 */
.item-image {
  width: 144rpx;
  height: 144rpx;
  border-radius: 12rpx;
  background-color: #fafafa;
  flex-shrink: 0;
}

/* 商品信息区 */
.item-info {
  flex: 1;
  margin-left: 20rpx;
  height: 144rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.item-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.item-spec {
  font-size: 22rpx;
  color: #aaa;
  margin-top: 4rpx;
}

/* 底部：价格 + 数量 */
.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.item-price {
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: 600;
}
.item-price::before {
  content: '¥';
  font-size: 22rpx;
  margin-right: 2rpx;
}

/* 数量加减器 */
.quantity-control {
  display: flex;
  align-items: center;
}
.qty-btn {
  width: 50rpx;
  height: 50rpx;
  background-color: #f2f3f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #333;
}
.qty-btn.disabled {
  color: #ccc;
}
.qty-num {
  min-width: 64rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 下架 */
.off-shelf-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.off-shelf-text {
  font-size: 30rpx;
  color: #ff4d4f;
  font-weight: 600;
  background-color: rgba(255, 255, 255, 0.9);
  padding: 10rpx 28rpx;
  border-radius: 8rpx;
  border: 2rpx solid #ff4d4f;
}

/* ===== 底部结算栏（fixed） ===== */
.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 104rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-bottom: env(safe-area-inset-bottom);
}
.footer-left {
  display: flex;
  align-items: center;
}
.footer-check-text {
  margin-left: 14rpx;
  font-size: 28rpx;
  color: #333;
}
.footer-right {
  display: flex;
  align-items: center;
}
.footer-total {
  margin-right: 24rpx;
}
.total-label {
  font-size: 26rpx;
  color: #666;
}
.total-price {
  font-size: 38rpx;
  color: #ff4d4f;
  font-weight: 700;
}
.footer-checkout-btn {
  background-color: #00cc99;
  color: #fff;
  padding: 0 44rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.footer-delete-btn {
  background-color: #ff4d4f;
  color: #fff;
  padding: 0 44rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 500;
}