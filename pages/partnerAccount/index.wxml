<!--pages/partnerAccount/index.wxml-->
<view class="page" wx:if="{{!isLogin}}">
  <!-- ===== 顶部品牌区 ===== -->
  <view class="brand-area">
    <image class="brand-logo" src="/images/logo.png" mode="aspectFit"></image>
    <text class="brand-title">信息门户</text>
    <text class="brand-subtitle">xiaodi电竞陪玩通道</text>
  </view>

  <!-- ===== Tab 切换 ===== -->
  <view class="tab-bar">
    <view class="tab-item {{currentTab === 'login' ? 'active' : ''}}" bind:tap="switchTab" data-tab="login">登录</view>
    <view class="tab-item {{currentTab === 'register' ? 'active' : ''}}" bind:tap="switchTab" data-tab="register">注册</view>
  </view>

  <!-- ===== 登录表单 ===== -->
  <view class="card form-card" wx:if="{{currentTab === 'login'}}">
    <view class="form-group">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="请输入手机号" maxlength="11" bindinput="onPhoneInput" value="{{phone}}"/>
    </view>
    <view class="form-group">
      <text class="form-label">密码</text>
      <input class="form-input" type="text" placeholder="请输入密码" bindinput="onPasswordInput" value="{{password}}"/>
    </view>
    <view class="form-extra">
      <checkbox class="agree-checkbox" checked="{{agree}}" bind:tap="onAgreeChange"/>
      <text class="agree-text">我已阅读并同意</text>
      <text class="agree-link">《用户协议》</text>
    </view>
    <button class="submit-btn" type="primary" bind:tap="handleLogin">登录</button>
    <view class="form-footer">
      <text class="footer-link" bind:tap="switchTab" data-tab="register">立即注册</text>
    </view>
  </view>

  <!-- ===== 注册表单 ===== -->
  <view class="card form-card" wx:else>
    <view class="form-group">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" placeholder="请输入手机号" maxlength="11" bindinput="onRegPhoneInput" value="{{regPhone}}"/>
    </view>
    <view class="form-group">
      <text class="form-label">密码</text>
      <input class="form-input" type="text" placeholder="6-20位字母数字组合" bindinput="onRegPwdInput" value="{{regPassword}}"/>
    </view>
    <!-- ===== 头像上传 ===== -->
    <view class="form-group avatar-group">
      <text class="form-label">头像</text>
      <view class="avatar-upload" bind:tap="chooseAvatar">
        <image class="avatar-preview" src="{{avatarTempUrl || '/images/logo.png'}}" mode="aspectFill"></image>
        <view class="avatar-tip" wx:if="{{!avatarTempUrl}}">
          <text class="avatar-tip-text">点击上传头像</text>
        </view>
      </view>
    </view>
    <view class="form-group">
      <text class="form-label">昵称</text>
      <input class="form-input" type="nickname" placeholder="给自己取个响亮的名字" bindinput="onNicknameInput" value="{{nickname}}"/>
    </view>
    <view class="form-group">
      <text class="form-label">性别</text>
      <view class="gender-group">
        <view class="gender-option {{gender === 'male' ? 'selected' : ''}}" bind:tap="selectGender" data-gender="male">男</view>
        <view class="gender-option {{gender === 'female' ? 'selected' : ''}}" bind:tap="selectGender" data-gender="female">女</view>
      </view>
    </view>
    <!-- ===== 个人标签 ===== -->
    <view class="form-group">
      <text class="form-label">个人标签</text>
      <view class="tag-input-row">
        <input class="form-input tag-input" type="text" placeholder="输入标签，如：国服" maxlength="10" value="{{tagInput}}" bindinput="onTagInput" />
        <button class="add-btn" size="mini" bind:tap="addTag">添加</button>
      </view>
      <view class="tag-list" wx:if="{{tags.length > 0}}">
        <view class="tag-item" wx:for="{{tags}}" wx:key="*this">
          <text class="tag-text">{{item}}</text>
          <text class="tag-del" bind:tap="removeTag" data-index="{{index}}">✕</text>
        </view>
      </view>
    </view>
    
    <!-- ===== 擅长游戏 ===== -->
    <view class="form-group">
      <text class="form-label">擅长游戏</text>
      <view class="game-input-row">
        <input class="form-input game-name-input" type="text" placeholder="游戏名称" maxlength="20" value="{{gameNameInput}}" bindinput="onGameNameInput" />
        <input class="form-input game-level-input" type="text" placeholder="段位/等级" maxlength="10" value="{{gameLevelInput}}" bindinput="onGameLevelInput" />
        <button class="add-btn" size="mini" bind:tap="addGame">添加</button>
      </view>
      <view class="game-list" wx:if="{{games.length > 0}}">
        <view class="game-item" wx:for="{{games}}" wx:key="index">
          <text class="game-name">{{item.name}}</text>
          <text class="game-level">{{item.level}}</text>
          <text class="game-del" bind:tap="removeGame" data-index="{{index}}">✕</text>
        </view>
      </view>
    </view>
    <view class="form-group">
      <text class="form-label">个人简介</text>
      <textarea class="form-textarea" placeholder="介绍一下自己" maxlength="100" bindinput="onBioInput" value="{{bio}}" />
      <text class="char-count">{{bio.length || 0}}/100</text>
    </view>
    <view class="form-extra">
      <checkbox class="agree-checkbox" checked="{{agree}}" bind:tap="onAgreeChange"/>
      <text class="agree-text">我已阅读并同意</text>
      <text class="agree-link">《陪玩入驻协议》</text>
    </view>
    <button class="submit-btn" type="primary" bind:tap="handleRegister">注册</button>
    <view class="form-footer">
      <text class="footer-link" bind:tap="switchTab" data-tab="login">已有账号？去登录</text>
    </view>
  </view>
</view>

<!-- ===== 登录后操作页面 ===== -->
<view class="page" wx:else>
  <!-- ===== 顶部：陪玩信息卡片 ===== -->
  <view class="card info-card">
    <view class="info-left">
      <image class="info-avatar" src="{{partnerInfo.imageSrc || '/images/logo.png'}}" mode="aspectFill"></image>
      <view class="info-detail">
        <text class="info-name">{{partnerInfo.nickname}}</text>
        <text class="info-phone">{{partnerInfo.phone}}</text>
      </view>
    </view>
    <view class="info-right">
      <text class="status-label">{{partnerInfo.isOnline ? '在线' : '离线'}}</text>
      <switch class="status-switch" checked="{{partnerInfo.isOnline}}" bindchange="onOnlineSwitch" color="#00cc99"/>
    </view>
  </view>

  <!-- ===== Tab 切换 ===== -->
  <view class="tab-bar">
    <view class="tab-item {{currentTab === 'orders' ? 'active' : ''}}" bind:tap="switchTab" data-tab="orders">待确认</view>
    <view class="tab-item {{currentTab === 'confirmed' ? 'active' : ''}}" bind:tap="switchTab" data-tab="confirmed">待完成</view>
    <view class="tab-item {{currentTab === 'goods' ? 'active' : ''}}" bind:tap="switchTab" data-tab="goods">我支持的商品</view>
  </view>

  <!-- ===== Tab1：待确认订单 ===== -->
  <view wx:if="{{currentTab === 'orders'}}">
    <!-- 空状态 -->
    <view class="empty" wx:if="{{pendingOrders.length === 0}}">
      <image class="empty-img" src="/images/empty-cart.png" mode="aspectFit"></image>
      <text class="empty-text">暂无待确认订单</text>
    </view>

    <!-- 订单列表 -->
    <view class="order-list" wx:else>
      <view class="order-card" wx:for="{{pendingOrders}}" wx:key="_id">
        <view class="order-header">
          <text class="order-id">订单号：{{item._id}}</text>
          <text class="order-status status-pending">待确认</text>
        </view>
        <view class="order-body">
          <image class="goods-img" src="{{item.goodData.imageSrc}}" mode="aspectFill"></image>
          <view class="goods-info">
            <text class="goods-name">{{item.goodData.name}}</text>
            <text class="goods-meta">数量: x {{item.amount}}</text>
          </view>
          <text class="goods-price">¥ {{item.amount * item.goodData.price}}</text>
        </view>
        <view class="order-footer">
          <text class="order-time">{{item.createTime}}</text>
          <view class="order-actions">
            <button class="confirm-btn" type="primary" size="mini" bind:tap="confirmOrder" data-id="{{item._id}}">确认订单</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== Tab2：待完成订单 ===== -->
  <view wx:elif="{{currentTab === 'confirmed'}}">
    <!-- 空状态 -->
    <view class="empty" wx:if="{{confirmedOrders.length === 0}}">
      <image class="empty-img" src="/images/empty-cart.png" mode="aspectFit"></image>
      <text class="empty-text">暂无待完成订单</text>
    </view>
  
    <!-- 订单列表 -->
    <view class="order-list" wx:else>
      <view class="order-card" wx:for="{{confirmedOrders}}" wx:key="_id">
        <view class="order-header">
          <text class="order-id">订单号：{{item._id}}</text>
          <text class="order-status status-confirmed">待完成</text>
        </view>
        <view class="order-body">
          <image class="goods-img" src="{{item.goodData.imageSrc}}" mode="aspectFill"></image>
          <view class="goods-info">
            <text class="goods-name">{{item.goodData.name}}</text>
            <text class="goods-meta">数量: x {{item.amount}}</text>
          </view>
          <text class="goods-price">¥ {{item.amount * item.goodData.price}}</text>
        </view>
        <view class="order-footer">
          <text class="order-time">{{item.createTime}}</text>
          <view class="order-actions">
            <button class="complete-btn" type="primary" size="mini" bind:tap="completeOrder" data-id="{{item._id}}">完成订单</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== Tab3：商品列表 ===== -->
  <view wx:elif="{{currentTab === 'goods'}}">
    <!-- ===== 搜索框 ===== -->
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索商品名称..." placeholder-class="placeholder" confirm-type="search" bindconfirm="searchGood" />
    </view>
    
    <!-- 空状态 -->
    <view class="empty" wx:if="{{goodsList.length === 0}}">
      <image class="empty-img" src="/images/empty-cart.png" mode="aspectFit"></image>
      <text class="empty-text">暂无商品</text>
    </view>

    <!-- 商品列表 -->
    <view class="goods-list" wx:else>
      <view class="goods-card" wx:for="{{goodsList}}" wx:key="_id">
        <image class="goods-img" src="{{item.imageSrc}}" mode="aspectFill"></image>
        <view class="goods-content">
          <text class="goods-name">{{item.name}}</text>
          <text class="goods-price">¥ {{item.price}}</text>
          <text class="goods-desc">{{item.description}}</text>
        </view>
        <button 
          class="choose-btn {{item.isChosen ? 'chosen' : ''}}" 
          size="mini" 
          bind:tap="toggleChooseGoods" 
          data-id="{{item._id}}"
        >
          {{item.isChosen ? '已绑定' : '绑定此商品'}}
        </button>
      </view>
    </view>
  </view>
</view>