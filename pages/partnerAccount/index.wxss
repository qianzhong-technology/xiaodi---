/* pages/partnerAccount/index.wxss */
/* ===== 页面 ===== */
.page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

/* ===== 品牌区 ===== */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}

.brand-logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
  border-radius: 50%;
}

.brand-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.brand-subtitle {
  font-size: 26rpx;
  color: #888;
}

/* ===== Tab 栏 ===== */
.tab-bar {
  display: flex;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  border: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #888;
  position: relative;
}

.tab-item.active {
  color: #1677ff;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 64rpx;
  height: 6rpx;
  background-color: #1677ff;
  border-radius: 3rpx;
}

/* ===== 表单卡片 ===== */
.form-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  border: 1rpx solid #eee;
}

.form-group {
  margin-bottom: 32rpx;
  position: relative;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 84rpx;
  background-color: #f8f9fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 180rpx;
  background-color: #f8f9fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  resize: none;
}

.char-count {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  font-size: 22rpx;
  color: #bbb;
}

/* ===== 性别选择 ===== */
.gender-group {
  display: flex;
  gap: 20rpx;
}

.gender-option {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background-color: #f8f9fa;
  border: 1rpx solid #e8e8e8;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #555;
}

.gender-option.selected {
  background-color: #e6f0ff;
  border-color: #1677ff;
  color: #1677ff;
  font-weight: 500;
}

/* ===== 协议勾选框 ===== */
.form-extra {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
}

.agree-checkbox {
  margin-right: 12rpx;
  transform: scale(0.75);
  transform-origin: left center;
}

.agree-text {
  font-size: 24rpx;
  color: #888;
}

.agree-link {
  font-size: 24rpx;
  color: #1677ff;
  margin-left: 4rpx;
}

/* ===== 提交按钮 ===== */
.submit-btn {
  border-radius: 46rpx;
  margin-bottom: 24rpx;
}

.submit-btn::after {
  border: none;
}

/* ===== 底部链接 ===== */
.form-footer {
  display: flex;
  justify-content: center;
  align-items: center;
}

.footer-link {
  font-size: 26rpx;
  color: #1677ff;
}

/* 顶部信息卡片 */
.info-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
}

.info-left {
  display: flex;
  align-items: center;
}

.info-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #e8e8e8;
  flex-shrink: 0;
}

.info-detail {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.info-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.info-phone {
  font-size: 26rpx;
  color: #888;
}

.info-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-label {
  font-size: 26rpx;
  color: #888;
}

.status-switch {
  transform: scale(0.85);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 160rpx;
}

.empty-img {
  width: 220rpx;
  height: 176rpx;
  opacity: 0.35;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #bbb;
}

/* 订单列表 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  border: 1rpx solid #eee;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-id {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 24rpx;
  font-weight: 500;
}

.status-pending { color: #faad14; }

.order-body {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 8rpx;
  background-color: #fafafa;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.goods-meta {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 8rpx;
}

.goods-price {
  font-size: 30rpx;
  font-weight: 600;
  color: #ff4d4f;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
}

.order-time {
  font-size: 22rpx;
  color: #bbb;
}

.confirm-btn {
  border-radius: 35rpx;
}

.confirm-btn::after {
  border: none;
}

/* 商品列表 */
.goods-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.goods-card {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  border: 1rpx solid #eee;
}

.goods-card .goods-img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 8rpx;
  background-color: #fafafa;
  flex-shrink: 0;
}

.goods-content {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.goods-content .goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 6rpx;
}

.goods-content .goods-price {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.goods-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.choose-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  border-radius: 28rpx;
  color: #1677ff;
}

.choose-btn.chosen {
  background: #e6f7e6;
  color: #00cc99;
  border-color: #00cc99;
}

.choose-btn::after {
  border: none;
}

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 80rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #e9ecef;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}
.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #212529;
}
.placeholder {
  color: #adb5bd;
  font-size: 26rpx;
}

/* ===== 头像上传 ===== */
.avatar-group {
  display: flex;
  flex-direction: column;
}

.avatar-upload {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #f8f9fa;
  border: 2rpx dashed #d9d9d9;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
  margin-top: 12rpx;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-tip {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0,0,0,0.25);
  border-radius: 50%;
}

.avatar-tip-text {
  font-size: 22rpx;
  color: #fff;
  text-align: center;
  line-height: 1.3;
}

/* ===== 标签输入行 ===== */
.tag-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tag-input {
  flex: 1;
}

.add-btn {
  flex-shrink: 0;
  background: linear-gradient(135deg, #00cc99, #33d6aa);
  color: #fff;
  border-radius: 30rpx;
  border: none;
}

.add-btn::after {
  border: none;
}

/* ===== 标签列表 ===== */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  background-color: #e6f7f0;
  border: 1rpx solid #b3e6d0;
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #00cc99;
}

.tag-text {
  margin-right: 12rpx;
}

.tag-del {
  color: #ff4d4f;
  font-size: 20rpx;
  font-weight: 700;
  cursor: pointer;
}

/* ===== 游戏输入行 ===== */
.game-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.game-name-input {
  flex: 2;
}

.game-level-input {
  flex: 1;
}

/* ===== 游戏列表 ===== */
.game-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.game-item {
  display: flex;
  align-items: center;
  background-color: #f8f9fa;
  border: 1rpx solid #eee;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.game-name {
  flex: 1;
  color: #333;
  font-weight: 500;
}

.game-level {
  color: #00cc99;
  margin-right: 20rpx;
}

.game-del {
  color: #ff4d4f;
  font-size: 22rpx;
  font-weight: 700;
  cursor: pointer;
}

/* ===== 完成按钮 ===== */
.complete-btn {
  border-radius: 28rpx;
}

.complete-btn::after {
  border: none;
}

/* 待完成状态颜色 */
.status-confirmed {
  color: #1677ff;
}